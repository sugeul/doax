{
    "compilerOptions": {
        "target": "es2024",
        "lib": ["es2024"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "customConditions": ["@doax/source"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "rewriteRelativeImportExtensions": true,
        "isolatedModules": true,
        "composite": true,
        "declaration": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "types": ["node"]
    }
}
