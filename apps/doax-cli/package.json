{
    "name": "doax-cli",
    "version": "0.1.0",
    "description": "doax developer CLI (Delegation of Object Access and eXecution): search, try, publish and audit registry resources from your device.",
    "license": "UNLICENSED",
    "type": "module",
    "bin": {
        "doax": "./dist/main.js"
    },
    "exports": {
        "./mcp": {
            "@doax/source": "./src/mcp.ts",
            "types": "./dist/mcp.d.ts",
            "default": "./dist/mcp.js"
        }
    },
    "files": ["dist"],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc -b",
        "dev": "node --conditions=@doax/source src/main.ts"
    },
    "dependencies": {
        "@doax/config": "workspace:*",
        "@doax/protocol": "workspace:*"
    },
    "publishConfig": {
        "access": "public"
    }
}
